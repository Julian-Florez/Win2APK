<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep a console attached so Wine/Winlator startup failures are visible. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Win2APKTest</AssemblyName>
    <RootNamespace>Win2APKTest</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The first target is Windows x64, as defined by the specification. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Keep CoreCLR's initial GC reservation small in Wine/Winlator containers. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="false" />
    <RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
  </ItemGroup>
</Project>
